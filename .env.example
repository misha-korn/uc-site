# =====================================================================
#  Настройки сайта. Скопируйте этот файл в .env и заполните значения.
#  Windows:  copy .env.example .env      Linux:  cp .env.example .env
#  Файл .env НЕЛЬЗЯ публиковать (он уже в .gitignore).
# =====================================================================

# --- Безопасность -----------------------------------------------------
# Длинная случайная строка. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# 1 — режим разработки (подробные ошибки), 0 — боевой режим. На сервере ВСЕГДА 0.
DEBUG=1
# Домены сайта через запятую, без http:// и без пробелов
ALLOWED_HOSTS=localhost,127.0.0.1
# Те же домены, но с протоколом (нужно для форм на HTTPS)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 1 — перенаправлять http -> https (включать, когда есть SSL-сертификат)
SECURE_SSL_REDIRECT=0
# Срок HSTS в секундах (браузер запоминает «только HTTPS»). Первый запуск: 3600, потом 31536000.
SECURE_HSTS_SECONDS=31536000
# 1 — разрешить внесение домена в preload-списки браузеров. Отменить почти невозможно — по умолчанию 0.
SECURE_HSTS_PRELOAD=0
# 1 — CSP только сообщает о нарушениях в консоль браузера, не блокируя (для отладки нового
# внешнего сервиса: карты, счётчика). В обычной работе — 0.
CSP_REPORT_ONLY=0
# 1 — доверять заголовку X-Forwarded-For. Ставьте 1, ТОЛЬКО если сайт стоит за своим nginx
# (Docker Compose и VPS по DEPLOY.md — да, docker-compose задаёт 1 сам). Без nginx — 0,
# иначе посетитель подделает IP и обойдёт лимит заявок.
USE_X_FORWARDED_FOR=0

# Лимит заявок: не более LEAD_RATE_LIMIT заявок с одного IP за LEAD_RATE_WINDOW секунд.
# Счётчик хранится в памяти процесса: при нескольких воркерах uvicorn лимит считается
# в каждом воркере отдельно — поэтому по умолчанию запускаем 1 воркер (WEB_CONCURRENCY=1).
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW=600

# --- База данных ------------------------------------------------------
# Пусто = SQLite (файл db.sqlite3 в папке проекта) — для разработки.
# Боевой сервер — PostgreSQL:
#   DATABASE_URL=postgres://uc_user:ПАРОЛЬ@localhost:5432/uc_site
DATABASE_URL=
# Время жизни соединения с БД, сек (0 — рекомендуется для ASGI)
DB_CONN_MAX_AGE=0

# --- Сайт -------------------------------------------------------------
# Адрес сайта: для ссылок в уведомлениях, sitemap.xml, canonical
SITE_URL=http://localhost:8000
# Демо-режим: плашка «Демо-версия, данные вымышленные», запрет индексации, seed_demo --reset без --force.
# 1 — только для демо-стенда! У заказчика (боевой сайт) — 0.
SITE_DEMO=0
# Пароль пользователя admin, которого создаёт seed_demo (только для демо!).
# Проверяется как обычный пароль Django: не короче 8 символов, не «популярный», не только цифры.
# При SITE_DEMO=0 слабый пароль не принимается — admin не создаётся.
DEMO_ADMIN_PASSWORD=
# Гостевой вход в панель для показа заказчику: пользователь demo, только просмотр,
# без доступа к заявкам. Работает только при SITE_DEMO=1.
DEMO_VIEWER_PASSWORD=
# Версия текста согласия на обработку ПДн (сохраняется в каждой заявке).
# Меняйте, когда меняете текст согласия.
CONSENT_VERSION=1.0 от 27.10.2026
# Уровень логов: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
# Шрифт с кириллицей для демо-PDF. Linux/Docker: пакет fonts-dejavu-core (путь ниже).
# Windows: C:\Windows\Fonts\arial.ttf
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# 1 — Django сам отдаёт /media/ (PDF-документы). Нужно на обычном хостинге без nginx.
# При DEBUG=1 или SITE_DEMO=1 включается автоматически. За nginx — 0.
SERVE_MEDIA=0
# Куда собирать статику и где лежат загруженные файлы (обычно менять не нужно).
# Пусто = папки staticfiles/ и media/ в корне проекта. Загрузка файлов в панели — до 20 МБ,
# только документы (PDF, DOC/DOCX, XLS/XLSX, ODT/ODS, SIG/P7S) и фото (JPG, PNG, WEBP).
STATIC_ROOT=
MEDIA_ROOT=

# --- Персональные данные (152-ФЗ) ---------------------------------------
# Сколько дней хранить заявки (должно совпадать с Политикой и Согласием: «1 год»).
# Удаляет команда `python manage.py purge_leads` (systemd-таймер / cron раз в сутки).
LEAD_RETENTION_DAYS=365
# Заявки со статусом «Спам» удаляются раньше.
LEAD_SPAM_RETENTION_DAYS=30

# --- Уведомления о заявках: e-mail (необязательно) ---------------------
# Если EMAIL_HOST пуст — письма не отправляются.
# Пример для Яндекс.Почты: smtp.yandex.ru, 465, EMAIL_USE_SSL=1, пароль приложения
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
# STARTTLS (порт 587) — EMAIL_USE_TLS=1 и EMAIL_USE_SSL=0
EMAIL_USE_TLS=0
EMAIL_TIMEOUT=5
DEFAULT_FROM_EMAIL=
# Куда слать уведомления (можно несколько через запятую)
LEADS_EMAIL_TO=

# --- Уведомления о заявках: Telegram (необязательно) -------------------
# Токен бота от @BotFather и ID чата (как узнать — см. README, раздел «Уведомления»)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Сколько секунд максимум ждать отправки уведомлений перед ответом посетителю
NOTIFY_TIMEOUT=5

# --- Только для docker-compose -----------------------------------------
# DATABASE_URL в Docker собирается автоматически из этих трёх значений
POSTGRES_DB=uc_site
POSTGRES_USER=uc_user
POSTGRES_PASSWORD=change-me-db-password
# Порт, на котором nginx будет доступен снаружи
HTTP_PORT=80
# Число процессов uvicorn. 1 — чтобы лимит заявок (LEAD_RATE_LIMIT) работал точно;
# для сайта учебного центра одного процесса (async) хватает с запасом.
WEB_CONCURRENCY=1
# 1 — при старте контейнера загрузить демо-данные (только для демо-стенда!)
SEED_DEMO=0
